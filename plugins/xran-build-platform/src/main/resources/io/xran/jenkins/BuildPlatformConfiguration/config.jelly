<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:f="/lib/form">
  <j:if test="${instance.admin}">
    <f:section title="构建平台设置">
      <f:entry><div class="jenkins-help">${instance.status}</div><p>设置保存后对新入场构建立刻生效；排队等待不计入总超时。运行中的构建保留入场时的配置。CPU、内存和临时存储为整个 Pod 的预算，内部容器自动分配。</p></f:entry>
      <f:invisibleEntry><input type="hidden" name="revision" value="${instance.revision}" /></f:invisibleEntry>
      <f:entry title="全局并发上限" field="concurrency">
        <f:number value="${instance.form.concurrency}" min="1" max="32" step="1" />
      </f:entry>
      <f:entry title="默认编译环境" field="compilerImage">
        <f:textbox value="${instance.form.compilerImage}" />
      </f:entry>
      <f:entry title="默认拉取策略" field="compilerImagePullPolicy">
        <f:select value="${instance.form.compilerImagePullPolicy}" />
      </f:entry>
      <f:entry title="xcn 离线构建" field="xcnOffline">
        <f:checkbox checked="${instance.form.xcnOffline}" />
      </f:entry>
      <f:entry title="X-RAN-CLOUD 服务编译串行执行" field="xranServiceSerial">
        <f:checkbox checked="${instance.form.xranServiceSerial}" />
        <div class="jenkins-help">适用于服务包及镜像任务中的服务编译。关闭后遵循业务脚本原有并行设置；不影响 Jenkins 全局并发。</div>
      </f:entry>
      <f:entry title="服务包 Pod CPU 总上限（核）" field="serviceCpu">
        <f:number value="${instance.form.serviceCpu}" min="2" max="128" step="1" />
      </f:entry>
      <f:entry title="服务包 Pod 内存总上限（GiB）" field="serviceMemoryGiB">
        <f:number value="${instance.form.serviceMemoryGiB}" min="2" max="1024" step="1" />
      </f:entry>
      <f:entry title="服务包 Pod 临时存储总上限（GiB）" field="serviceTemporaryStorageGiB">
        <f:number value="${instance.form.serviceTemporaryStorageGiB}" min="1" max="1024" step="1" />
      </f:entry>
      <f:entry title="镜像 Pod CPU 总上限（核）" field="imageCpu">
        <f:number value="${instance.form.imageCpu}" min="2" max="128" step="1" />
      </f:entry>
      <f:entry title="镜像 Pod 内存总上限（GiB）" field="imageMemoryGiB">
        <f:number value="${instance.form.imageMemoryGiB}" min="2" max="1024" step="1" />
      </f:entry>
      <f:entry title="镜像 Pod 临时存储总上限（GiB）" field="imageTemporaryStorageGiB">
        <f:number value="${instance.form.imageTemporaryStorageGiB}" min="1" max="1024" step="1" />
      </f:entry>
      <f:entry title="镜像 DinD 内存（GiB）" field="imageDindMemoryGiB">
        <f:number value="${instance.form.imageDindMemoryGiB}" min="2" max="1022" step="1" />
      </f:entry>
      <f:entry title="xcn Pod CPU 总上限（核）" field="xcnCpu">
        <f:number value="${instance.form.xcnCpu}" min="2" max="128" step="1" />
      </f:entry>
      <f:entry title="xcn Pod 内存总上限（GiB）" field="xcnMemoryGiB">
        <f:number value="${instance.form.xcnMemoryGiB}" min="2" max="1024" step="1" />
      </f:entry>
      <f:entry title="xcn Pod 临时存储总上限（GiB）" field="xcnTemporaryStorageGiB">
        <f:number value="${instance.form.xcnTemporaryStorageGiB}" min="1" max="1024" step="1" />
      </f:entry>
      <f:entry title="xcn DinD 内存（GiB）" field="xcnDindMemoryGiB">
        <f:number value="${instance.form.xcnDindMemoryGiB}" min="2" max="1022" step="1" />
      </f:entry>
      <f:entry title="xcn 内层 Docker 构建内存（GiB）" field="innerBuildMemoryGiB">
        <f:number value="${instance.form.innerBuildMemoryGiB}" min="1" max="1021" step="1" />
      </f:entry>
      <f:entry title="xcn 内层构建并行数" field="buildJobs">
        <f:number value="${instance.form.buildJobs}" min="1" max="128" step="1" />
      </f:entry>
      <f:entry title="入场后总超时（分钟，包含 Pod 启动）" field="buildTimeoutMinutes">
        <f:number value="${instance.form.buildTimeoutMinutes}" min="1" max="10080" step="1" />
      </f:entry>
      <f:entry title="Pod 启动超时（分钟）" field="agentStartupTimeoutMinutes">
        <f:number value="${instance.form.agentStartupTimeoutMinutes}" min="1" max="120" step="1" />
      </f:entry>
      <f:entry title="磁盘最小可用空间（GiB）" field="minimumFreeGiB">
        <f:number value="${instance.form.minimumFreeGiB}" min="1" max="1048576" step="1" />
      </f:entry>
      <f:entry title="磁盘最小可用比例（%）" field="minimumFreePercent">
        <f:number value="${instance.form.minimumFreePercent}" min="0" max="79" step="1" />
      </f:entry>
      <f:entry>
        <f:validateButton title="预览内部资源分配" progress="计算中…" method="preview" with="concurrency,compilerImage,compilerImagePullPolicy,xcnOffline,xranServiceSerial,serviceCpu,serviceMemoryGiB,serviceTemporaryStorageGiB,imageCpu,imageMemoryGiB,imageTemporaryStorageGiB,imageDindMemoryGiB,xcnCpu,xcnMemoryGiB,xcnTemporaryStorageGiB,xcnDindMemoryGiB,innerBuildMemoryGiB,buildJobs,buildTimeoutMinutes,agentStartupTimeoutMinutes,minimumFreeGiB,minimumFreePercent" />
        <f:validateButton title="重新应用配置" progress="应用中…" method="reapply" />
      </f:entry>
      <f:advanced title="最近修改审计（完整记录保存在 Jenkins 数据目录）">
        <pre style="white-space:pre-wrap;max-height:24rem;overflow:auto">${instance.auditText}</pre>
      </f:advanced>
    </f:section>
  </j:if>
</j:jelly>
